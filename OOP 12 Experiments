class Value {
private:
    int number;

public:
    Value(int n = 0) : number(n) {}

    void display() const {
        cout << "Value: " << number << endl;
    }

    Value operator-() {
        Value temp;
        temp.number = -number;
        return temp;
    }
};

int main() {
    int initialVal;
    cout << "Enter an integer value: ";
    cin >> initialVal;

    Value v1(initialVal);
    cout << "\nOriginal Value:" << endl;
    v1.display();

    Value v2 = -v1;
    cout << "\nNegated Value (using Unary - operator):" << endl;
    v2.display();

    return 0;
}


#include <iostream>

using namespace std;

class Counter {
private:
    int count;

public:
    Counter(int c = 0) : count(c) {}

    void display() const {
        cout << "Count: " << count << endl;
    }

    Counter operator++() {
        ++count;
        return *this;
    }

    Counter operator++(int) {
        Counter temp = *this;
        count++;
        return temp;
    }
};

int main() {
    Counter c1(5);
    cout << "Initial value of c1:" << endl;
    c1.display();

    Counter c2 = ++c1;
    cout << "\nAfter PRE-INCREMENT (++c1):" << endl;
    cout << "c1: "; c1.display();
    cout << "c2: "; c2.display();

    Counter c3 = c1++;
    cout << "\nAfter POST-INCREMENT (c1++):" << endl;
    cout << "c1: "; c1.display();
    cout << "c3 (returned old value): "; c3.display();

    return 0;
}



#include <iostream>
#include <string>

using namespace std;

class MyString {
private:
    string s;

public:
    MyString(const string& str = "") : s(str) {}

    void display() const {
        cout << "String: " << s << endl;
    }

    MyString operator+(const MyString& other) const {
        MyString result;
        result.s = this->s + other.s;
        return result;
    }
};

int main() {
    MyString str1("xyz");
    MyString str2("pqr");

    cout << "String 1:" << endl;
    str1.display();
    cout << "String 2:" << endl;
    str2.display();

    MyString str3 = str1 + str2;

    cout << "\nResult after concatenation (str1 + str2):" << endl;
    str3.display();

    return 0;
}


#include <iostream>
#include <string>

using namespace std;

class ILogin {
protected:
    string username;
    string password;

public:
    ILogin() {}
    ILogin(string u, string p) : username(u), password(p) {}

    void setCredentials() {
        cout << "Enter Username/ID: ";
        cin >> username;
        cout << "Enter Password: ";
        cin >> password;
    }

    virtual void accept() {
        setCredentials();
    }

    virtual void displayLoginDetails() const = 0;
};

class EmailLogin : public ILogin {
private:
    string emailAddress;

public:
    EmailLogin() : ILogin() {}

    void accept() override {
        ILogin::setCredentials();
        cout << "Enter Email Address: ";
        cin >> emailAddress;
    }

    void displayLoginDetails() const override {
        cout << "\n--- Email Login Details ---" << endl;
        cout << "Username: " << username << endl;
        cout << "Email: " << emailAddress << endl;
    }
};

class MembershipLogin : public ILogin {
private:
    int membershipId;

public:
    MembershipLogin() : ILogin() {}

    void accept() override {
        ILogin::setCredentials();
        cout << "Enter Membership ID: ";
        cin >> membershipId;
    }

    void displayLoginDetails() const override {
        cout << "\n--- Membership Login Details ---" << endl;
        cout << "Username: " << username << endl;
        cout << "Membership ID: " << membershipId << endl;
    }
};

int main() {
    ILogin* ptr;
    
    EmailLogin eLogin;
    cout << "Enter Email Login Details:" << endl;
    eLogin.accept();
    
    MembershipLogin mLogin;
    cout << "\nEnter Membership Login Details:" << endl;
    mLogin.accept();

    ptr = &eLogin;
    ptr->displayLoginDetails();

    ptr = &mLogin;
    ptr->displayLoginDetails();

    return 0;
}


