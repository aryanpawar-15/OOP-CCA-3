#include <iostream>
#include <vector>
#include <numeric>
#include <iomanip>

using namespace std;

class SumCalculator {
public:
    double calculateSum(const vector<float>& floats) const {
        double sum = 0.0;
        for (float val : floats) {
            sum += val;
        }
        return sum;
    }

    int calculateSum(const vector<int>& integers) const {
        int sum = 0;
        for (int val : integers) {
            sum += val;
        }
        return sum;
    }
};

int main() {
    SumCalculator sc;

    vector<float> floatValues(5);
    cout << "Enter 5 float values:" << endl;
    for (int i = 0; i < 5; ++i) {
        cout << "Float " << i + 1 << ": ";
        cin >> floatValues[i];
