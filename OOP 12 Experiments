    for (int i = 0; i < 10; ++i) {
        cout << "Integer " << i + 1 << ": ";
        cin >> intValues[i];
    }

    cout << "\n--- Sum Calculations (Function Overloading) ---" << endl;
    cout << fixed << setprecision(2);
    cout << "Sum of 5 Floats: " << sc.calculateSum(floatValues) << endl;
    cout << "Sum of 10 Integers: " << sc.calculateSum(intValues) << endl;

    return 0;
}


