#include <iostream>
#include <string>
#include <limits>
#include <algorithm>

using namespace std;

class City {
private:
    string cityName;
    long population;

public:
    void getCityData() {
        cout << "Enter city name: ";
        getline(cin, cityName);
        cout << "Enter population: ";
        cin >> population;
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }

    void displayCityData() const {
        cout << "City: " << cityName << ", Population: " << population;
    }

    long getPopulation() const {
        return population;
    }

    string getName() const {
        return cityName;
    }
};

void findHighestPopulation(City cities[], int size) {
    if (size == 0) {
        cout << "No cities entered." << endl;
        return;
    }

    City highest = cities[0];
    for (int i = 1; i < size; ++i) {
        if (cities[i].getPopulation() > highest.getPopulation()) {
            highest = cities[i];
        }
    }

    cout << "\nCity with the highest population is:" << endl;
    highest.displayCityData();
    cout << endl;
}

int main() {
    const int NUM_CITIES = 3;
    City cities[NUM_CITIES];

    for (int i = 0; i < NUM_CITIES; ++i) {
        cout << "\nEnter details for city " << i + 1 << endl;
        cities[i].getCityData();
    }

    findHighestPopulation(cities, NUM_CITIES);

    return 0;
}


#include <iostream>
#include <string>
#include <iomanip>

using namespace std;

class Account {
private:
    int accNumber;
    string accName;
    double balance;
    const double INTEREST_RATE = 0.10;

public:
    void getAccountData() {
        cout << "Enter Account Number: ";
        cin >> accNumber;
        cout << "Enter Account Holder Name: ";
        cin.ignore();
        getline(cin, accName);
        cout << "Enter Initial Balance: ";
        cin >> balance;
    }

    void calculateInterest() {
        if (balance >= 5000) {
            double interest = balance * INTEREST_RATE;
            balance += interest;
        }
    }

    void displayAccountData() const {
        cout << left << setw(15) << accNumber
             << left << setw(20) << accName
             << fixed << setprecision(2) << balance << endl;
    }
};

int main() {
    const int NUM_ACCOUNTS = 10;
    Account accounts[NUM_ACCOUNTS];

    for (int i = 0; i < NUM_ACCOUNTS; ++i) {
        cout << "\nEnter details for Account " << i + 1 << endl;
        accounts[i].getAccountData();
        accounts[i].calculateInterest();
    }

    cout << "\n" << string(50, '-') << endl;
    cout << left << setw(15) << "Account No."
         << left << setw(20) << "Name"
         << "New Balance" << endl;
    cout << string(50, '-') << endl;

    for (int i = 0; i < NUM_ACCOUNTS; ++i) {
        accounts[i].displayAccountData();
    }
    cout << string(50, '-') << endl;

    return 0;
}


