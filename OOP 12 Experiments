#include <iostream>
#include <fstream>
#include <cctype>

using namespace std;

int main() {
    ifstream inputFile("Count.txt", ios::in);

    if (!inputFile) {
        cerr << "Error: Count.txt not found or could not be opened." << endl;
        return 1;
    }

    int digitCount = 0;
    int spaceCount = 0;
    char ch;

    while (inputFile.get(ch)) {
        if (isdigit(ch)) {
            digitCount++;
        } else if (isspace(ch)) {
            spaceCount++;
        }
    }

    cout << "--- File Analysis (Digits and Spaces) ---" << endl;
    cout << "Total Digits Found: " << digitCount << endl;
    cout << "Total Spaces Found: " << spaceCount << endl;

    inputFile.close();
    return 0;
}


