class Base {
protected:
    int value;
public:
    Base(int v) : value(v) {
        cout << "Base Constructor called with value " << value << endl;
    }
    void showValue() const {
        cout << "Base Value: " << value << endl;
    }
};

class Derived1 : virtual public Base {
public:
    Derived1(int v1, int baseV) : Base(baseV) {
        cout << "Derived1 Constructor called." << endl;
    }
};

class Derived2 : virtual public Base {
public:
    Derived2(int v2, int baseV) : Base(baseV) {
        cout << "Derived2 Constructor called." << endl;
    }
};

class FinalDerived : public Derived1, public Derived2 {
private:
    int result;
public:
    FinalDerived(int v1, int v2, int baseV)
        : Base(baseV), Derived1(v1, baseV), Derived2(v2, baseV) {
        result = v1 + v2 + baseV;
        cout << "FinalDerived Constructor called." << endl;
    }
    void displayResult() const {
        cout << "\n--- FinalDerived Details (Virtual Base Class) ---" << endl;
        showValue();
        cout << "Calculated Result: " << result << endl;
    }
};

int main() {
    FinalDerived fd(10, 20, 5);
    fd.displayResult();
    return 0;
}



