#include <iostream>

using namespace std;

class ClassB;

class ClassA {
private:
    int numA;
public:
    ClassA(int n) : numA(n) {}
    friend void findGreatest(ClassA a, ClassB b);
};

class ClassB {
private:
    int numB;
public:
    ClassB(int n) : numB(n) {}
    friend void findGreatest(ClassA a, ClassB b);
};

void findGreatest(ClassA a, ClassB b) {
    cout << "\nComparing numbers (" << a.numA << " and " << b.numB << "):" << endl;
    if (a.numA > b.numB) {
        cout << a.numA << " from ClassA is the greatest." << endl;
    } else if (b.numB > a.numA) {
        cout << b.numB << " from ClassB is the greatest." << endl;
    } else {
        cout << "Both numbers are equal." << endl;
    }
}

int main() {
    int valA, valB;
    cout << "Enter a number for Class A: ";
    cin >> valA;
    cout << "Enter a number for Class B: ";
    cin >> valB;

    ClassA objA(valA);
    ClassB objB(valB);

    findGreatest(objA, objB);

    return 0;
}


#include <iostream>

using namespace std;

class Value {
private:
    int data;
public:
    Value(int d) : data(d) {}

    void display() const {
        cout << "Data: " << data;
    }

    friend void swapValues(Value& v1, Value& v2);
};

void swapValues(Value& v1, Value& v2) {
    int temp = v1.data;
    v1.data = v2.data;
    v2.data = temp;
}

int main() {
    int val1, val2;
    cout << "Enter value for V1: ";
    cin >> val1;
    cout << "Enter value for V2: ";
    cin >> val2;

    Value V1(val1);
    Value V2(val2);

    cout << "\nBefore swap:" << endl;
    cout << "V1: ";
    V1.display();
    cout << endl;
    cout << "V2: ";
    V2.display();
    cout << endl;

    swapValues(V1, V2);

    cout << "\nAfter swap (using friend function):" << endl;
    cout << "V1: ";
    V1.display();
    cout << endl;
    cout << "V2: ";
    V2.display();
    cout << endl;

    return 0;
}


