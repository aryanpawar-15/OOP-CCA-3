#include <iostream>
#include <stack>

using namespace std;

void implementStack() {
    stack<int> s;

    s.push(10);
    cout << "Pushed: 10" << endl;
    s.push(20);
    cout << "Pushed: 20" << endl;
    s.push(30);
    cout << "Pushed: 30" << endl;

    cout << "Top element is: " << s.top() << endl;
    
    cout << "Popped: " << s.top() << endl;
    s.pop();

    cout << "Popped: " << s.top() << endl;
    s.pop();

    cout << "Is stack empty? " << (s.empty() ? "Yes" : "No") << endl;
}

int main() {
    implementStack();
    return 0;
}



#include <iostream>
#include <queue>
#include <string>

using namespace std;

void implementQueue() {
    queue<string> q;

    q.push("First");
    cout << "Pushed: First" << endl;
    q.push("Second");
    cout << "Pushed: Second" << endl;
    q.push("Third");
    cout << "Pushed: Third" << endl;

    cout << "Front element is: " << q.front() << endl;

    cout << "Popped (Served): " << q.front() << endl;
    q.pop();

    cout << "Popped (Served): " << q.front() << endl;
    q.pop();

    cout << "Is queue empty? " << (q.empty() ? "Yes" : "No") << endl;
}

int main() {
    implementQueue();
    return 0;
}
